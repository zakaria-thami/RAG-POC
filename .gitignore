# ---- Secrets ---------------------------------------------------------------
# Real API keys live only in .env; the committed template is .env.example
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials.json
service-account*.json

# ---- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---- Virtual environments --------------------------------------------------
venv/
.venv/
env/
ENV/

# ---- Editor / tool-local settings ------------------------------------------
# Machine-specific (absolute paths, browser location); nothing shared lives here
.vscode/
.idea/
.claude/settings.local.json
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ---- Runtime state (regenerated by the app) --------------------------------
# Chat transcript with every prompt/answer, grows on each request
data/chat.log
*.log
# Persisted vector index, rebuilt from data/Documentations
data/index/
# Output of answer_all(): one entry per questionnaire question
data/answers.json

# ---- Uploaded documents ----------------------------------------------------
# data/Documentations is the upload target: anything dropped there at runtime
# may be a real (confidential) company document, so ignore the folder and
# allow-list only the synthetic sample PDFs that ship with the POC.
data/Documentations/*
!data/Documentations/documentazione_tecnica_talentmatch.pdf
!data/Documentations/dpia_talentmatch.pdf
!data/Documentations/guida_stampanti_ufficio.pdf
!data/Documentations/procedura_gestione_incidenti.pdf
!data/Documentations/regolamento_ferie_permessi.pdf
